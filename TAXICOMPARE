<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>TaxiCompare: сравнение цен на такси</title>
<style>
:root { box-sizing: border-box; --bg:#f5f6fa; --card:#fff; --text:#1c1f2a; --muted:#6b7080; --accent:#2f6bff; --good:#18a058; --line:#e3e6ee; color-scheme: light; }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { --bg:#12141c; --card:#1d2030; --text:#eceef5; --muted:#9097a8; --accent:#5b87ff; --good:#38c57a; --line:#2c3144; color-scheme: dark; } }
:root[data-theme="dark"] { --bg:#12141c; --card:#1d2030; --text:#eceef5; --muted:#9097a8; --accent:#5b87ff; --good:#38c57a; --line:#2c3144; color-scheme: dark; }
* { margin:0; }
body { font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; background:var(--bg); color:var(--text); padding:16px; min-height:100vh; line-height:1.4; }
main { max-width:640px; margin:0 auto; display:grid; gap:14px; }
h1 { font-size:1.4rem; }
h2 { font-size:1.05rem; margin-bottom:8px; }
.sub { color:var(--muted); font-size:.9rem; }
.card { background:var(--card); border:1px solid var(--line); border-radius:14px; padding:16px; }
label { display:block; font-size:.85rem; color:var(--muted); margin-bottom:4px; }
input, select, button { font:inherit; }
input[type=number], select { width:100%; padding:10px; border:1px solid var(--line); border-radius:10px; background:var(--bg); color:var(--text); }
.row { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
.toggle { display:flex; align-items:center; gap:8px; margin-top:12px; }
button.primary { background:var(--accent); color:#fff; border:0; border-radius:10px; padding:12px 16px; cursor:pointer; width:100%; font-weight:600; }
.chips { display:flex; flex-wrap:wrap; gap:8px; margin-top:10px; }
.chip { border:1px solid var(--line); background:var(--bg); color:var(--text); border-radius:999px; padding:6px 12px; cursor:pointer; font-size:.85rem; }
.offer { display:grid; grid-template-columns:auto 1fr auto; gap:12px; align-items:center; padding:12px; border:1px solid var(--line); border-radius:12px; background:var(--bg); }
.offer.best { border-color:var(--good); box-shadow:0 0 0 1px var(--good) inset; }
.badge { font-size:.75rem; background:var(--good); color:#fff; padding:2px 8px; border-radius:999px; }
.price { font-size:1.15rem; font-weight:700; text-align:right; }
.offer .name { font-weight:600; }
.offer .meta { font-size:.8rem; color:var(--muted); }
.offer button { margin-top:6px; background:none; border:1px solid var(--accent); color:var(--accent); border-radius:8px; padding:5px 10px; cursor:pointer; font-size:.82rem; }
.saving { font-size:1.05rem; font-weight:700; color:var(--good); }
.ad { margin-top:12px; font-size:.8rem; color:var(--muted); border-top:1px dashed var(--line); padding-top:10px; }
.stats { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; text-align:center; }
.stats b { display:block; font-size:1.3rem; }
.stats span { font-size:.8rem; color:var(--muted); }
.note { font-size:.8rem; color:var(--muted); }
.hidden { display:none; }
</style>
</head>
<body>
<main>
  <header>
    <h1>TaxiCompare</h1>
    <p class="sub">Сравнение цен на такси от разных перевозчиков. Тарифы демонстрационные, цены ориентировочные. Все суммы в тенге (₸).</p>
  </header>

  <section class="card">
    <h2>Маршрут</h2>
    <div class="chips" id="routes"></div>
    <div class="row" style="margin-top:12px">
      <div><label for="km">Расстояние, км</label><input id="km" type="number" min="0.5" step="0.5" value="5"></div>
      <div><label for="min">Время в пути, мин</label><input id="min" type="number" min="1" step="1" value="15"></div>
    </div>
    <div class="toggle">
      <input id="peak" type="checkbox">
      <label for="peak" style="margin:0;color:var(--text)">Час пик (коэффициент подорожания)</label>
    </div>
    <div style="margin-top:14px"><button class="primary" id="compare">Сравнить цены</button></div>
    <p class="note" id="err" style="color:#d33;margin-top:8px"></p>
  </section>

  <section class="card hidden" id="resultCard">
    <h2>Результат</h2>
    <p class="saving" id="saving"></p>
    <div id="offers" style="display:grid;gap:10px;margin-top:10px"></div>
    <div class="ad" id="adBlock">
      <strong>Реклама:</strong> <span id="adText"></span>
    </div>
  </section>

  <section class="card">
    <h2>Статистика сервиса</h2>
    <div class="stats">
      <div><b id="sCompare">0</b><span>сравнений</span></div>
      <div><b id="sClick">0</b><span>переходов</span></div>
      <div><b id="sRev">0 ₸</b><span>расчётный доход</span></div>
    </div>
    <p class="note" style="margin-top:10px">Доход расчётный: 1 000 ₸ за нового клиента перевозчика (допущение). Данные хранятся в браузере.</p>
    <p class="note"><button id="reset" style="background:none;border:0;color:var(--accent);cursor:pointer;padding:0">Сбросить статистику</button></p>
  </section>
</main>

<script>
const CARRIERS = [
  { id: "express", name: "Экспресс Такси", boarding: 400, perKm: 120, perMin: 25, minFare: 800, peak: 1.4, ref: "https://example.com/ref/express" },
  { id: "city",    name: "ГородСкай",      boarding: 350, perKm: 135, perMin: 20, minFare: 700, peak: 1.3, ref: "https://example.com/ref/citysky" },
  { id: "rapid",   name: "Быстрый Ride",   boarding: 500, perKm: 110, perMin: 30, minFare: 900, peak: 1.5, ref: "https://example.com/ref/rapid" }
];
const ROUTES = [
  { label: "Центр → Медеу", km: 12, min: 25 },
  { label: "Центр → Аэропорт", km: 15, min: 30 },
  { label: "Вуз → Общежитие", km: 4, min: 12 },
  { label: "Офис → Дом", km: 8, min: 20 }
];
const AD = { name: "Партнёрский блок «Рекомендуем»", text: "Место в блоке рекламы не влияет на порядок цен в основном списке." };
const REF_FEE = 1000;

const KEY = "taxicompare_stats_v1";
const load = () => { try { return JSON.parse(localStorage.getItem(KEY)) || { compare: 0, click: 0 }; } catch { return { compare: 0, click: 0 }; } };
const save = (s) => { try { localStorage.setItem(KEY, JSON.stringify(s)); } catch {} };
let stats = load();

const $ = (id) => document.getElementById(id);
const fmt = (n) => Math.round(n).toLocaleString("ru-RU") + " ₸";

function price(c, km, min, peak) {
  const base = c.boarding + c.perKm * km + c.perMin * min;
  const total = base * (peak ? c.peak : 1);
  return Math.max(c.minFare, Math.round(total / 10) * 10);
}

function renderStats() {
  $("sCompare").textContent = stats.compare;
  $("sClick").textContent = stats.click;
  $("sRev").textContent = fmt(stats.click * REF_FEE);
}

function compare() {
  const km = parseFloat($("km").value);
  const min = parseFloat($("min").value);
  const peak = $("peak").checked;
  if (!(km > 0) || !(min > 0)) {
    $("err").textContent = "Введите расстояние и время больше нуля.";
    return;
  }
  $("err").textContent = "";

  const list = CARRIERS.map(c => ({ c, p: price(c, km, min, peak) })).sort((a, b) => a.p - b.p);
  const cheapest = list[0], priciest = list[list.length - 1];

  $("saving").textContent = "Сэкономите " + fmt(priciest.p - cheapest.p) + " с перевозчиком «" + cheapest.c.name + "»";

  const box = $("offers");
  box.textContent = "";
  list.forEach((item, i) => {
    const row = document.createElement("div");
    row.className = "offer" + (i === 0 ? " best" : "");

    const left = document.createElement("div");
    left.textContent = i + 1;
    left.style.fontWeight = "700";

    const mid = document.createElement("div");
    const name = document.createElement("div");
    name.className = "name";
    name.textContent = item.c.name + " ";
    if (i === 0) {
      const b = document.createElement("span");
      b.className = "badge";
      b.textContent = "Дешевле всех";
      name.appendChild(b);
    }
    const meta = document.createElement("div");
    meta.className = "meta";
    meta.textContent = "Посадка " + item.c.boarding + " ₸ · " + item.c.perKm + " ₸/км · " + item.c.perMin + " ₸/мин" + (peak ? " · час пик" : "");
    const btn = document.createElement("button");
    btn.textContent = "Заказать";
    btn.addEventListener("click", () => {
      stats.click += 1;
      save(stats);
      renderStats();
      window.open(item.c.ref, "_blank", "noopener");
    });
    mid.append(name, meta, btn);

    const pr = document.createElement("div");
    pr.className = "price";
    pr.textContent = fmt(item.p);

    row.append(left, mid, pr);
    box.appendChild(row);
  });

  $("adText").textContent = AD.name + ". " + AD.text;
  $("resultCard").classList.remove("hidden");

  stats.compare += 1;
  save(stats);
  renderStats();
}

function buildRoutes() {
  const wrap = $("routes");
  ROUTES.forEach(r => {
    const b = document.createElement("button");
    b.className = "chip";
    b.textContent = r.label;
    b.addEventListener("click", () => {
      $("km").value = r.km;
      $("min").value = r.min;
    });
    wrap.appendChild(b);
  });
}

$("compare").addEventListener("click", compare);
$("reset").addEventListener("click", () => {
  stats = { compare: 0, click: 0 };
  save(stats);
  renderStats();
});
buildRoutes();
renderStats();
</script>
</body>
</html>
